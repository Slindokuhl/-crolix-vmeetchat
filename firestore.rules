rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // isPremium/stripe* are only ever set by the stripeWebhook Cloud
      // Function via the Admin SDK, which bypasses these rules entirely.
      // Blocking client writes to just these fields prevents anyone from
      // granting themselves Premium for free via devtools.
      allow read, delete: if true;
      allow create: if !('isPremium' in request.resource.data) || request.resource.data.isPremium == false;
      allow update: if !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isPremium', 'stripeCustomerId', 'stripeSubscriptionId']);
    }
    // {sub=**} matches zero-or-more segments, so it would also match
    // /users/{userId} itself and re-open the isPremium restriction above
    // (rules are OR'd across matching blocks). Requiring one concrete
    // segment before the recursive wildcard limits this to actual
    // subcollections (e.g. users/{userId}/categories/{catId}).
    match /users/{userId}/{collection}/{sub=**} {
      allow read, write: if true;
    }
    match /meetingIds/{meetId} {
      allow read, write: if true;
    }
    match /otpCodes/{email} {
      allow read, write: if true;
    }
    match /meetings/{meetingId} {
      allow read, write: if true;
    }
    match /meetings/{meetingId}/{sub=**} {
      allow read, write: if true;
    }
    match /chats/{chatId}/{sub=**} {
      allow read, write: if true;
    }
    match /incomingCalls/{userId} {
      allow read, write: if true;
    }
    match /groups/{groupId}/{sub=**} {
      allow read, write: if true;
    }

    // Collection-group query (RecordingsController's collectionGroup("recordings")
    // lookup) needs its own explicit rule — the meetings/{id}/{sub=**} wildcard above
    // covers direct path reads/writes but not a raw collection-group query.
    match /{path=**}/recordings/{recId} {
      allow read, write: if true;
    }
  }
}
